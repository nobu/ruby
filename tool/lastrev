#!/bin/sh

: ${git=git}

date_type=cd
width=10
limit=20
prefix=RUBY

usage() {
    echo "usage: $0 [options] [working-directory [head]]
options:
  -g, --git=git-command         specify the git command ($git)
  -d, --date=author|committer   specify date type (committer)
  -w, --width=width             abbreviation width ($width)
  -l, --limit=NUM               limit branch name length ($limit)
  -p, --prefix=PREFIX           use PREFIX as the symbol prefix ($prefix)
"
    exit ${1}
}

die () {
    echo "${0##*/}: $1" 1>&2
    usage 1 1>&2
}

while getopts g:d:w:l:p:h-: opt; do
    optarg="$OPTARG"
    if [ "$opt" = "-" ]; then
        opt="-${optarg%%=*}"
        case "$optarg" in
            *=*)
                optarg="${optarg#*=}";;
            *)
                eval 'optarg="${'$OPTIND'}"'
                case "${optarg}" in
                    -*)
                        optarg=;;
                    *)
                        shift $OPTIND; OPTIND=1;;
                esac
        esac
    fi

    case "-$opt" in
        -g|--git)
            git="$optarg";;
        -d|--date)
            case author in "$optarg"*) date_type=ad; :;; *) false;; esac ||
            case committer in "$optarg"*) date_type=cd; :;; *) false;; esac ||
            die "Unknown date $optarg";;
        -w|--width)
            width=`expr 0 + "$optarg"`;;
        -l|--limit)
            limit=`expr 0 + "$optarg"`;;
        -p|--prefix)
            prefix="$optarg";;
        -h|--help)
            usage;;
        --)
            break;;
        -*)
            die "Unknown option $1";;
    esac
done
shift $((OPTIND-1))

gitdir="${1-.}" head="${2-HEAD}"

branch=`${git} -C "${gitdir}" symbolic-ref --short "${head}" 2>/dev/null` || branch="$head"
set _ `${git} -C "${gitdir}" log -1 --no-show-signature "--format=%<($limit,trunc)%S" "${branch}" 2>/dev/null` "$branch"
branch="$2"

title=`${git} -C "${gitdir}" log -1 --no-show-signature "--format=%s" "${head}@{upstream}..${head}" |
       sed 's/"/\\"/g'`

set _ `${git} -C "${gitdir}" log -1 --no-show-signature "--abbrev=${width}" \
     "--date=format-local:%FT%TZ %Y %m %d" "--format=%h %H %${date_type}" "${head}" -- 2>/dev/null`
shift

[ -z ${1+set} ] && exit

echo "#define ${prefix}_REVISION \"$1\""
echo "#define ${prefix}_FULL_REVISION \"${2}\""
echo "#define ${prefix}_BRANCH_NAME \"${branch}\""
${title:+echo "#define ${prefix}_LAST_COMMIT_TITLE \"${title}\\\\n\""}
echo "#define ${prefix}_RELEASE_DATETIME \"${3}\""
echo "#define ${prefix}_RELEASE_YEAR ${4}"
echo "#define ${prefix}_RELEASE_MONTH ${5#0}"
echo "#define ${prefix}_RELEASE_DAY ${6#0}"
